function(omodsim_openssl_binary_abi result)
    foreach(binary IN LISTS ARGN)
        if(NOT EXISTS "${binary}")
            continue()
        endif()
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_READELF)
            execute_process(
                COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C "${CMAKE_READELF}" -d "${binary}"
                OUTPUT_VARIABLE dependencies ERROR_QUIET)
            if(dependencies MATCHES "\\(NEEDED\\)[^\n]*\\[lib(crypto|ssl)\\.so\\.([0-9]+(\\.[0-9]+)?)\\]")
                set(${result} "${CMAKE_MATCH_2}" PARENT_SCOPE)
                return()
            endif()
        endif()
        # Qt stores OPENSSL_VERSION_TEXT as a QStringLiteral.
        foreach(encoding IN ITEMS UTF-16LE UTF-16BE)
            file(STRINGS "${binary}" version ENCODING "${encoding}" LIMIT_COUNT 1
                REGEX "^OpenSSL [0-9]+\\.[0-9]+\\.[0-9]+")
            if(version MATCHES "^OpenSSL (1\\.[0-9]+|[0-9]+)\\.")
                set(${result} "${CMAKE_MATCH_1}" PARENT_SCOPE)
                return()
            endif()
        endforeach()
    endforeach()
    set(${result} "" PARENT_SCOPE)
endfunction()

function(omodsim_openssl_qt_abi result qt_package)
    get_target_property(network "${qt_package}::Network" LOCATION)
    if(TARGET "${qt_package}::QTlsBackendOpenSSLPlugin")
        get_target_property(backend "${qt_package}::QTlsBackendOpenSSLPlugin" LOCATION)
    endif()
    omodsim_openssl_binary_abi(abi "${backend}" "${network}")
    set(${result} "${abi}" PARENT_SCOPE)
endfunction()

function(omodsim_openssl_version_range result abi)
    if(abi STREQUAL "1.1")
        set(range "1.1.1...<1.2")
    elseif(abi MATCHES "^[0-9]+$" AND abi GREATER_EQUAL 3)
        math(EXPR next_major "${abi} + 1")
        set(range "${abi}...<${next_major}")
    elseif(abi STREQUAL "")
        set(range "1.1.1")
    else()
        message(FATAL_ERROR "Unsupported Qt OpenSSL ABI: ${abi}")
    endif()
    set(${result} "${range}" PARENT_SCOPE)
endfunction()
