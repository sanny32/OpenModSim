function(omodsim_openssl_qt_hint result qt_binary_dir openssl_abi pointer_size)
    if(openssl_abi STREQUAL "3")
        set(package OpenSSLv3)
    else()
        set(package OpenSSL11)
    endif()
    if(pointer_size EQUAL 8)
        set(arch x64)
    else()
        set(arch x86)
    endif()
    get_filename_component(qt_root "${qt_binary_dir}/../../.." ABSOLUTE)
    set(${result} "${qt_root}/Tools/${package}/Win_${arch}" PARENT_SCOPE)
endfunction()
